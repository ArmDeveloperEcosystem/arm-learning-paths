@@ -0,0 +1,49 @@
+From 20f4b6dd508128439f746af770753fab8174924b Mon Sep 17 00:00:00 2001
+From: Julien Jayat <julien.jayat@arm.com>
+Date: Wed, 2 Sep 2026 10:00:00 +0200
+Subject: [PATCH] build: support the GCC 13 toolchain
+
+Adapt the demo to build correctly with the aarch64-none-elf GCC 13.3
+toolchain supplied by meta-arm.
+
+GCC 13 does not recognise cortex-r82ae, so use its equivalent cortex-r82
+CPU name. Also compile crt_replacements.c with -fno-builtin-memset to stop
+GCC 13 optimizing the replacement memset implementation into a recursive
+call to itself.
+
+Also allow the recipe to supply a source-prefix map. This prevents absolute
+Yocto build paths used by FreeRTOS assertions from entering the raw firmware.
+
+Upstream-Status: Inappropriate [Yocto toolchain compatibility]
+Signed-off-by: Julien Jayat <julien.jayat@arm.com>
+---
+ CMakeLists.txt      | 4 ++++
+ gnu_toolchain.cmake | 4 ++--
+ 2 files changed, 6 insertions(+), 2 deletions(-)
+
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+index 9e48e8d..e36555f 100644
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -79,6 +79,10 @@ target_sources(${DEMO_TARGET_NAME}
+ 	    ${DEMO_SOURCE_DIR}/crt_replacements.c
+ )
+ 
++set_source_files_properties(crt_replacements.c PROPERTIES
++    COMPILE_OPTIONS "$<$<C_COMPILER_ID:GNU>:-fno-builtin-memset>"
++)
++
+ target_include_directories(${DEMO_TARGET_NAME}
+ 	PRIVATE
+ 	    ${DEMO_SOURCE_DIR}
+diff --git a/gnu_toolchain.cmake b/gnu_toolchain.cmake
+index b8a5144..72c9775 100644
+--- a/gnu_toolchain.cmake
++++ b/gnu_toolchain.cmake
+@@ -16,2 +16,2 @@
+-set(CMAKE_C_FLAGS "-mcpu=cortex-r82ae -mabi=lp64 -mlittle-endian -Wall -Wextra -mstrict-align -Wno-return-type -Wno-unused-parameter -Wno-attributes -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast")
+-set(CMAKE_ASM_FLAGS "-mcpu=cortex-r82ae -mabi=lp64 -Wall")
++set(CMAKE_C_FLAGS "-mcpu=cortex-r82 -mabi=lp64 -mlittle-endian -Wall -Wextra -mstrict-align -Wno-return-type -Wno-unused-parameter -Wno-attributes -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast ${FREERTOS_SOURCE_PREFIX_MAP}")
++set(CMAKE_ASM_FLAGS "-mcpu=cortex-r82 -mabi=lp64 -Wall ${FREERTOS_SOURCE_PREFIX_MAP}")
+-- 
+2.43.0
