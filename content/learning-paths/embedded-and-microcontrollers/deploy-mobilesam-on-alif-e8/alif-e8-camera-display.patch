+int cdc200_disable_at_vblank(const struct device *dev, k_timeout_t timeout)
+{
+	struct cdc200_data *data = dev->data;
+	const struct cdc200_config *config = dev->config;
+	uintptr_t regs = DEVICE_MMIO_GET(dev);
+	int ret;
+
+	if (!config->panel_cfg.vfp)
+		return -ENOTSUP;
+	/* Reap an ISR completion that arrived after an earlier caller timed out. */
+	if (atomic_get(&data->stop_state) == CDC200_STOP_CLAIMED &&
+	    k_sem_take(&data->stop_sem, K_NO_WAIT) == 0)
+		atomic_set(&data->stop_state, CDC200_STOP_IDLE);
+	if (!atomic_cas(&data->stop_state, CDC200_STOP_IDLE, CDC200_STOP_ARMING))
+		return -EBUSY;
+	if (!(sys_read32(regs + CDC_GLB_CTRL) & CDC_GLB_CTRL_CDC_EN)) {
+		atomic_set(&data->stop_state, CDC200_STOP_IDLE);
+		return 0;
+	}
+
+	k_sem_reset(&data->stop_sem);
+	atomic_set(&data->stop_state, CDC200_STOP_PENDING);
+	ret = k_sem_take(&data->stop_sem, timeout);
+	if (ret) {
+		/* A claimed request must finish before another caller can arm a stop. */
+		atomic_cas(&data->stop_state, CDC200_STOP_PENDING, CDC200_STOP_IDLE);
+		LOG_ERR("CDC did not stop at vertical blanking: position=0x%08x",
+			sys_read32(regs + CDC_POS_STAT));
+		return ret;
+	}
+	atomic_set(&data->stop_state, CDC200_STOP_IDLE);
+	return 0;
+}
