+int dsi_dw_suspend_video(const struct device *dev)
+{
+	struct dsi_dw_data *data = dev->data;
+	uintptr_t regs = DEVICE_MMIO_GET(dev);
+	uint32_t mask = DSI_PHY_STATUS_PHY_STOPSTATECLKLANE |
+			DSI_PHY_STATUS_PHY_STOPSTATE0LANE;
+	uint32_t status;
+	int ret;
+
+	if (data->phy.num_lanes == 2)
+		mask |= DSI_PHY_STATUS_PHY_STOPSTATE1LANE;
+	else if (data->phy.num_lanes != 1)
+		return -EINVAL;
+
+	if (data->curr_mode == DSI_DW_VIDEO_MODE) {
+		uint32_t empty_mask = DSI_VID_PKT_STATUS_DPI_BUFF_PLD_EMPTY |
+				      DSI_VID_PKT_STATUS_DPI_PLD_W_EMPTY |
+				      DSI_VID_PKT_STATUS_DPI_CMD_W_EMPTY;
+		uint32_t data_mask = mask & ~DSI_PHY_STATUS_PHY_STOPSTATECLKLANE;
+		uint32_t video_status;
+		bool drained = false;
+
+		/* CDC must already be stopped at VFP; COMMAND mode clears these status bits. */
+		for (int i = 0; i < 100; i++) {
+			video_status = sys_read32(regs + DSI_VID_PKT_STATUS);
+			status = sys_read32(regs + DSI_PHY_STATUS);
+			if ((video_status & empty_mask) == empty_mask &&
+			    (status & (data_mask | DSI_PHY_STATUS_PHY_PHY_DIRECTION)) == data_mask) {
+				drained = true;
+				break;
+			}
+			k_sleep(K_MSEC(1));
+		}
+		if (!drained) {
+			LOG_ERR("DSI video did not drain: VID_PKT_STATUS=0x%08x PHY_STATUS=0x%08x",
+				video_status, status);
+			return -ETIMEDOUT;
+		}
+	}
+
+	ret = dsi_dw_set_mode(dev, DSI_DW_COMMAND_MODE);
+	if (ret)
+		return ret;
+
+	/* HS command panels otherwise keep the clock lane active while idle. */
+	sys_clear_bits(regs + DSI_LPCLK_CTRL, DSI_LPCLK_CTRL_PHY_TXREQUESTCLKHS);
+	for (int i = 0; i < 100; i++) {
+		status = sys_read32(regs + DSI_PHY_STATUS);
+		if ((status & (mask | DSI_PHY_STATUS_PHY_PHY_DIRECTION)) == mask) {
+			dsi_dw_pwr_down(regs);
+			return 0;
+		}
+		k_sleep(K_MSEC(1));
+	}
+
+	dsi_dw_pwr_down(regs);
+	LOG_ERR("DSI lanes did not stop before suspension: PHY_STATUS=0x%08x", status);
+	return -ETIMEDOUT;
 }
 
