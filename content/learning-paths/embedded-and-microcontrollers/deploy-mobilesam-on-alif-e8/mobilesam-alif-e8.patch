+/* Copyright 2026 Arm Limited and/or its affiliates.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/dt-bindings/clock/alif_ensemble_clocks.h>
+#include <dt-bindings/misc/alif_aipm_ensemble_gen2.h>
+
+/delete-node/ &sram0;
+/delete-node/ &sram1;
+
+&{/soc} {
+	sram0: sram@2000000 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x02000000 DT_SIZE_K(768)>;
+		zephyr,memory-region = "SRAM0";
+		zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM>;
+	};
+
+	app_sram: sram@20c0000 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x020c0000 0x740000>;
+		zephyr,memory-region = "APP_RAM";
+		zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM>;
+	};
+};
+
+/ {
+	chosen {
+		zephyr,sram = &app_sram;
+		zephyr,display = &cdc200;
+	};
+};
+
+&cdc200 {
+	width = <480>;
+	height = <800>;
+	hfront-porch = <5>;
+	hback-porch = <5>;
+	hsync-len = <4>;
+	vfront-porch = <10>;
+	vback-porch = <10>;
+	vsync-len = <2>;
+	clock-frequency = <24364080>;
+	hsync-active = <0>;
+	vsync-active = <0>;
+	de-active = <1>;
+	pixelclk-active = <0>;
+	bg-color = <0>;
+	enable-l1 = <1>;
+	pixel-fmt-l1 = "rgb-565";
+	def-back-color-l1 = <0>;
+	win-x0-l1 = <0>;
+	win-y0-l1 = <0>;
+	win-x1-l1 = <480>;
+	win-y1-l1 = <800>;
+	blend-factor1-l1 = <4>;
+	blend-factor2-l1 = <5>;
+	const-alpha-l1 = <0xff>;
+	enable-l2 = <0>;
+	pixel-fmt-l2 = "undefined";
+	win-x0-l2 = <0>;
+	win-y0-l2 = <0>;
+	win-x1-l2 = <0>;
+	win-y1-l2 = <0>;
+	blend-factor1-l2 = <6>;
+	blend-factor2-l2 = <7>;
+	const-alpha-l2 = <0xff>;
+};
+
+&aipm_run_default {
+	ip-clock-gating = <(ALIF_IP_CLK_GATE_NPU_HP_MASK |
+			    ALIF_IP_CLK_GATE_OSPI_1_MASK |
+			    ALIF_IP_CLK_GATE_CDC200_MASK |
+			    ALIF_IP_CLK_GATE_CAMERA_MASK |
+			    ALIF_IP_CLK_GATE_MIPI_CSI_MASK |
+			    ALIF_IP_CLK_GATE_MIPI_DSI_MASK)>;
+	phy-pwr-gating = <(ALIF_PHY_GATE_MIPI_TX_DPHY_MASK |
+			    ALIF_PHY_GATE_MIPI_RX_DPHY_MASK |
+			    ALIF_PHY_GATE_MIPI_PLL_DPHY_MASK |
+			    ALIF_PHY_GATE_LDO_MASK)>;
+};
+
+&clk_38p4m {
+	status = "okay";
+};
+
+&mipi_dsi {
+	status = "okay";
+};
+
+&gpio14 {
+	status = "okay";
+
+	display_mux {
+		gpio-hog;
+		gpios = <2 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+};
+
+&gpio6 {
+	status = "okay";
+};
+
+&gpio9 {
+	status = "okay";
+};
+
+&lpgpio {
+	status = "okay";
+};
+
+&pinctrl {
+	pinctrl_mobilesam_flash: pinctrl_mobilesam_flash {
+		group0 {
+			pinmux = <PIN_P5_5__OSPI1_SCLK_C>,
+				 <PIN_P5_7__OSPI1_SS0_C>;
+			read-enable = <0x0>;
+			drive-strength = <12>;
+			slew-rate = <0x1>;
+		};
+		group1 {
+			pinmux = <PIN_P9_5__OSPI1_D0_C>,
+				 <PIN_P9_6__OSPI1_D1_C>,
+				 <PIN_P9_7__OSPI1_D2_C>,
+				 <PIN_P10_0__OSPI1_D3_C>,
+				 <PIN_P10_1__OSPI1_D4_C>,
+				 <PIN_P10_2__OSPI1_D5_C>,
+				 <PIN_P10_3__OSPI1_D6_C>,
+				 <PIN_P10_4__OSPI1_D7_C>,
+				 <PIN_P10_7__OSPI1_RXDS0_C>;
+			read-enable = <0x1>;
+			drive-strength = <12>;
+			slew-rate = <0x1>;
+		};
+	};
+};
+
+&ospi1 {
+	pinctrl-0 = <&pinctrl_mobilesam_flash>;
+	status = "okay";
+};
+
+&ospi_flash {
+	status = "okay";
+};
+
+&ethosu1 {
+	status = "okay";
+};
