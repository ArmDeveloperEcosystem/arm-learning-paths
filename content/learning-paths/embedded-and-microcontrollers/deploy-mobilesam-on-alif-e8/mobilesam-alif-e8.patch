+
+void fill_rect(
+    size_t x,
+    size_t y,
+    size_t width,
+    size_t height,
+    uint16_t color) {
+  const size_t x_end = std::min(x + width, kScreenWidth);
+  const size_t y_end = std::min(y + height, kScreenHeight);
+  for (size_t row = y; row < y_end; ++row) {
+    std::fill(
+        pixels + row * kScreenWidth + x,
+        pixels + row * kScreenWidth + x_end,
+        color);
+  }
+}
+
+const uint8_t* glyph(char character) {
+  if (character >= 'a' && character <= 'z') {
+    character -= 'a' - 'A';
+  }
+  if (character < ' ' || character > 'Z') {
+    character = '?';
+  }
+  return kFont[character - ' '];
+}
+
+void draw_text(
+    size_t x,
+    size_t y,
+    const char* text,
+    size_t scale,
+    uint16_t color) {
+  while (*text != '\0') {
+    const uint8_t* columns = glyph(*text++);
+    for (size_t column = 0; column < 5; ++column) {
+      for (size_t row = 0; row < 7; ++row) {
+        if ((columns[column] & (1u << row)) != 0) {
+          fill_rect(x + column * scale, y + row * scale, scale, scale, color);
+        }
+      }
+    }
+    x += 6 * scale;
+  }
+}
+
+void draw_centered(size_t y, const char* text, size_t scale, uint16_t color) {
+  const size_t width = std::strlen(text) * 6 * scale - scale;
+  draw_text((kScreenWidth - width) / 2, y, text, scale, color);
+}
+
+uint16_t alpha_blend(uint16_t background, uint16_t foreground, uint8_t alpha) {
+  const uint32_t inverse_alpha = 255 - alpha;
+  const uint32_t red = (((background >> 11) & 0x1f) * inverse_alpha +
+                        ((foreground >> 11) & 0x1f) * alpha + 127) /
+      255;
+  const uint32_t green = (((background >> 5) & 0x3f) * inverse_alpha +
+                          ((foreground >> 5) & 0x3f) * alpha + 127) /
+      255;
+  const uint32_t blue = ((background & 0x1f) * inverse_alpha +
+                         (foreground & 0x1f) * alpha + 127) /
+      255;
+  return static_cast<uint16_t>((red << 11) | (green << 5) | blue);
+}
+
+void draw_logo(
+    size_t x,
+    size_t y,
+    size_t width,
+    size_t height,
+    const uint16_t* logo_pixels,
+    const uint8_t* logo_alpha) {
+  for (size_t row = 0; row < height; ++row) {
+    for (size_t column = 0; column < width; ++column) {
+      const size_t logo_index = row * width + column;
+      uint16_t& screen_pixel = pixels[(y + row) * kScreenWidth + x + column];
+      screen_pixel = alpha_blend(
+          screen_pixel, logo_pixels[logo_index], logo_alpha[logo_index]);
+    }
+  }
+}
+
+uint8_t model_pixel(
+    const int8_t* frame_data,
+    size_t channel,
+    size_t x,
+    size_t y) {
+  const size_t index =
+      channel * image_width * image_height + y * image_width + x;
+  const float normalized =
+      (static_cast<int32_t>(frame_data[index]) - model_input_zero_point) *
+      model_input_scale;
+  const int value = static_cast<int>(
+      normalized * model_pixel_std[channel] + model_pixel_mean[channel] + 0.5f);
+  return static_cast<uint8_t>(std::clamp(value, 0, 255));
+}
+
+uint16_t blend_mask(uint16_t color, const MaskColor& mask_color) {
+  const uint8_t red = static_cast<uint8_t>(((color >> 11) & 0x1f) << 3);
+  const uint8_t green = static_cast<uint8_t>(((color >> 5) & 0x3f) << 2);
+  const uint8_t blue = static_cast<uint8_t>((color & 0x1f) << 3);
+  return rgb565(
+      static_cast<uint8_t>((red * 5 + mask_color.red * 3) / 8),
+      static_cast<uint8_t>((green * 5 + mask_color.green * 3) / 8),
+      static_cast<uint8_t>((blue * 5 + mask_color.blue * 3) / 8));
+}
+
+void draw_image(
+    const int8_t* frame_data,
+    const int8_t* masks,
+    const size_t* mask_offsets,
+    size_t object_count,
+    size_t mask_height,
+    size_t mask_width,
+    size_t row_stride,
+    size_t column_stride) {
+  for (size_t y = 0; y < kImageSize; ++y) {
+    for (size_t x = 0; x < kImageSize; ++x) {
+      uint16_t color = rgb565(8, 14, 22);
+      if (frame_data != nullptr) {
+        const size_t source_x = x * image_width / kImageSize;
+        const size_t source_y = y * image_height / kImageSize;
+        color = rgb565(
+            model_pixel(frame_data, 0, source_x, source_y),
+            model_pixel(frame_data, 1, source_x, source_y),
+            model_pixel(frame_data, 2, source_x, source_y));
+      }
+      pixels[(kImageY + y) * kScreenWidth + kImageX + x] = color;
+    }
+  }
+
+  if (masks != nullptr) {
+    for (size_t object = 0; object < object_count; ++object) {
+      const int8_t* mask = masks + mask_offsets[object];
+      const MaskColor& mask_color =
+          kMaskColors[object % (sizeof(kMaskColors) / sizeof(kMaskColors[0]))];
+      for (size_t y = 0; y < kImageSize; ++y) {
+        const size_t mask_y = y * mask_height / kImageSize;
+        const size_t y_in_cell = y * mask_height % kImageSize;
+        for (size_t x = 0; x < kImageSize; ++x) {
+          const size_t mask_x = x * mask_width / kImageSize;
+          const size_t index = mask_y * row_stride + mask_x * column_stride;
+          const bool foreground =
+              (static_cast<int32_t>(mask[index]) - model_output_zero_point) *
+                  model_output_scale >
+              kMaskThreshold;
+          if (!foreground) {
+            continue;
+          }
+
+          const size_t x_in_cell = x * mask_width % kImageSize;
+          const auto is_foreground = [&](size_t query_x, size_t query_y) {
+            const size_t query_index =
+                query_y * row_stride + query_x * column_stride;
+            return (static_cast<int32_t>(mask[query_index]) -
+                    model_output_zero_point) *
+                model_output_scale >
+                kMaskThreshold;
+          };
+          const bool boundary =
+              (x_in_cell < mask_width &&
+               (mask_x == 0 || !is_foreground(mask_x - 1, mask_y))) ||
+              (x_in_cell >= kImageSize - mask_width &&
+               (mask_x + 1 == mask_width ||
+                !is_foreground(mask_x + 1, mask_y))) ||
+              (y_in_cell < mask_height &&
+               (mask_y == 0 || !is_foreground(mask_x, mask_y - 1))) ||
+              (y_in_cell >= kImageSize - mask_height &&
+               (mask_y + 1 == mask_height ||
+                !is_foreground(mask_x, mask_y + 1)));
+          uint16_t& pixel = pixels[(kImageY + y) * kScreenWidth + kImageX + x];
+          pixel =
+              boundary ? mask_color.boundary : blend_mask(pixel, mask_color);
+        }
+      }
+    }
+  }
+
+  fill_rect(kImageX - 2, kImageY - 2, kImageSize + 4, 2, kCardBorder);
+  fill_rect(kImageX - 2, kImageY + kImageSize, kImageSize + 4, 2, kCardBorder);
+  fill_rect(kImageX - 2, kImageY, 2, kImageSize, kCardBorder);
+  fill_rect(kImageX + kImageSize, kImageY, 2, kImageSize, kCardBorder);
+
+}
+
+void draw_card(
+    size_t x,
+    const char* label,
+    const char* value,
+    uint16_t accent) {
+  fill_rect(x, 606, 216, 116, kCardBorder);
+  fill_rect(x + 2, 608, 212, 112, kCard);
+  fill_rect(x + 2, 608, 5, 112, accent);
+  draw_text(x + 18, 622, label, 1, kMuted);
+  draw_text(x + 18, 658, value, 3, kWhite);
+}
+
+void draw_dashboard(
+    const int8_t* frame_data,
+    const int8_t* masks,
+    const size_t* mask_offsets,
+    size_t object_count,
+    size_t mask_height,
+    size_t mask_width,
+    size_t row_stride,
+    size_t column_stride,
+    uint64_t inference_ms,
+    const size_t* foreground_pixels) {
+  fill_rect(0, 0, kScreenWidth, kScreenHeight, kBackground);
+  fill_rect(0, 0, kScreenWidth, 70, kHeader);
+  fill_rect(0, 68, kScreenWidth, 2, kCyan);
+  fill_rect(10, 10, 48, 48, kWhite);
+  draw_logo(
+      14,
+      14,
+      executorch_logo_width,
+      executorch_logo_height,
+      executorch_logo_pixels,
+      executorch_logo_alpha);
+  draw_logo(
+      350,
+      20,
+      pytorch_logo_width,
+      pytorch_logo_height,
+      pytorch_logo_pixels,
+      pytorch_logo_alpha);
+  draw_centered(12, "MOBILE SAM", 3, kWhite);
+  draw_centered(48, "ALIF E8 / ETHOS-U85", 1, kMuted);
+  draw_image(
+      frame_data,
+      masks,
+      mask_offsets,
+      object_count,
+      mask_height,
+      mask_width,
+      row_stride,
+      column_stride);
+
+  fill_rect(16, 548, 448, 42, kCard);
+  fill_rect(16, 548, 6, 42, masks == nullptr ? kYellow : kGreen);
+  char status_text[32];
+  std::snprintf(
+      status_text,
+      sizeof(status_text),
+      masks == nullptr ? "STARTING LIVE CAMERA" : "%zu OBJECTS SEGMENTED",
+      object_count);
+  draw_text(
+      34,
+      562,
+      status_text,
+      2,
+      masks == nullptr ? kYellow : kGreen);
+
+  char left_value[24];
+  char right_value[24];
+  char footer[64];
+  if (masks == nullptr) {
+    std::snprintf(left_value, sizeof(left_value), "U85-256");
+    std::snprintf(right_value, sizeof(right_value), "RUNNING");
+    std::snprintf(
+        footer, sizeof(footer), "%zu OBJECT PROMPTS READY", point_prompt_count);
+    draw_card(16, "NPU", left_value, kCyan);
+    draw_card(248, "STATE", right_value, kYellow);
+  } else {
+    std::snprintf(
+        left_value, sizeof(left_value), "%" PRIu64 " MS", inference_ms);
+    std::snprintf(right_value, sizeof(right_value), "%zu", object_count);
+    size_t total_foreground = 0;
+    for (size_t object = 0; object < object_count; ++object) {
+      total_foreground += foreground_pixels[object];
+    }
+    std::snprintf(
+        footer,
+        sizeof(footer),
+        "LIVE CAMERA / %zu MASK PIXELS",
+        total_foreground);
+    draw_card(16, "INFERENCE", left_value, kCyan);
+    draw_card(248, "OBJECTS", right_value, kGreen);
+  }
+  draw_centered(754, footer, 1, kMuted);
+  draw_centered(778, "EXECUTORCH ON DEVICE AI", 1, kMuted);
+  sys_cache_data_flush_range(framebuffer.fb_addr, framebuffer.fb_size);
+}
+
+} // namespace
+
+bool initialize_display() {
+  display_device = DEVICE_DT_GET(DT_CHOSEN(zephyr_display));
+  if (!device_is_ready(display_device)) {
+    printk("ERROR display is not ready\n");
+    return false;
+  }
+
+  const struct device* dsi = DEVICE_DT_GET(DT_NODELABEL(mipi_dsi));
+  if (!device_is_ready(dsi)) {
+    printk("ERROR MIPI-DSI host is not ready\n");
+    return false;
+  }
+  if (dsi_dw_set_mode(dsi, DSI_DW_VIDEO_MODE) != 0) {
+    printk("ERROR could not enable MIPI-DSI video mode\n");
+    return false;
+  }
+
+  cdc200_get_framebuffer(display_device, 0, &framebuffer);
+  if (framebuffer.fb_addr == nullptr ||
+      framebuffer.fb_size != kScreenWidth * kScreenHeight * sizeof(uint16_t)) {
+    printk(
+        "ERROR unexpected display framebuffer size: %zu\n",
+        framebuffer.fb_size);
+    return false;
+  }
+  pixels = reinterpret_cast<uint16_t*>(framebuffer.fb_addr);
+  std::fill(pixels, pixels + kScreenWidth * kScreenHeight, kBackground);
+  sys_cache_data_flush_range(framebuffer.fb_addr, framebuffer.fb_size);
+  cdc200_set_enable(display_device, true);
+  display_ready = true;
+  return true;
+}
+
+void display_running() {
+  if (display_ready) {
+    draw_dashboard(nullptr, nullptr, nullptr, 0, 0, 0, 0, 0, 0, nullptr);
+  }
+}
+
+void display_result(
+    const int8_t* frame_data,
+    const int8_t* masks,
+    const size_t* mask_offsets,
+    size_t object_count,
+    size_t mask_height,
+    size_t mask_width,
+    size_t row_stride,
+    size_t column_stride,
+    uint64_t inference_ms,
+    const size_t* foreground_pixels) {
+  if (display_ready) {
+    draw_dashboard(
+        frame_data,
+        masks,
+        mask_offsets,
+        object_count,
+        mask_height,
+        mask_width,
+        row_stride,
+        column_stride,
+        inference_ms,
+        foreground_pixels);
+  }
+}
