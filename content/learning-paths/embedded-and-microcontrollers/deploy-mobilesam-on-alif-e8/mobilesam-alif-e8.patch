+
+using executorch::aten::ScalarType;
+using executorch::aten::Tensor;
+using executorch::extension::BufferDataLoader;
+using executorch::runtime::Error;
+using executorch::runtime::EValue;
+using executorch::runtime::HierarchicalAllocator;
+using executorch::runtime::MemoryManager;
+using executorch::runtime::Method;
+using executorch::runtime::MethodMeta;
+using executorch::runtime::Program;
+using executorch::runtime::Result;
+using executorch::runtime::Span;
+
+alignas(16) static uint8_t method_pool[ET_ARM_METHOD_ALLOCATOR_POOL_SIZE];
+__attribute__((section(".bss.tensor_arena"), aligned(16))) static uint8_t
+    temp_pool[ET_ARM_BAREMETAL_SCRATCH_TEMP_ALLOCATOR_POOL_SIZE];
+
+extern "C" {
+size_t ethosu_fast_scratch_size =
+    ET_ARM_BAREMETAL_FAST_SCRATCH_TEMP_ALLOCATOR_POOL_SIZE;
+__attribute__((section(".bss.ethosu_scratch"), aligned(16))) static uint8_t
+    fast_scratch[ET_ARM_BAREMETAL_FAST_SCRATCH_TEMP_ALLOCATOR_POOL_SIZE];
+uint8_t* ethosu_fast_scratch = fast_scratch;
+}
+
+namespace {
+
+constexpr size_t kMaxPlannedBuffers = 4;
+constexpr size_t kCandidatesPerPoint = 3;
+constexpr size_t kMaxCandidates = 16;
+constexpr size_t kMaxObjects = 4;
+constexpr float kMaskThreshold = ET_SEGMENTATION_MASK_THRESHOLD;
+constexpr float kDuplicateIou = 0.75f;
+
+struct Candidate {
+  size_t offset;
+  size_t foreground;
+  float quality;
+};
+
+struct SelectedMasks {
+  size_t count;
+  size_t offsets[kMaxObjects];
+  size_t foreground[kMaxObjects];
+};
+
+float mask_score(const int8_t* data, size_t index) {
+  return (static_cast<int32_t>(data[index]) - model_output_zero_point) *
+      model_output_scale;
+}
+
+bool is_foreground(
+    const int8_t* data,
+    size_t offset,
+    size_t y,
+    size_t x,
+    size_t row_stride,
+    size_t column_stride) {
+  return mask_score(data, offset + y * row_stride + x * column_stride) >
+      kMaskThreshold;
+}
+
+size_t count_foreground(
+    const int8_t* data,
+    size_t offset,
+    size_t height,
+    size_t width,
+    size_t row_stride,
+    size_t column_stride) {
+  size_t foreground = 0;
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      foreground += is_foreground(
+          data, offset, y, x, row_stride, column_stride);
+    }
+  }
+  return foreground;
+}
+
+float mask_iou(
+    const int8_t* data,
+    size_t first_offset,
+    size_t second_offset,
+    size_t height,
+    size_t width,
+    size_t row_stride,
+    size_t column_stride) {
+  size_t intersection = 0;
+  size_t union_count = 0;
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      const bool first = is_foreground(
+          data, first_offset, y, x, row_stride, column_stride);
+      const bool second = is_foreground(
+          data, second_offset, y, x, row_stride, column_stride);
+      intersection += first && second;
+      union_count += first || second;
+    }
+  }
+  return union_count == 0
+      ? 1.0f
+      : static_cast<float>(intersection) / static_cast<float>(union_count);
+}
+
+bool select_masks(
+    const Tensor& masks,
+    const Tensor& quality,
+    SelectedMasks& selected) {
+  if (masks.dim() != 4 || masks.size(0) != point_prompt_count ||
+      masks.size(1) != kCandidatesPerPoint ||
+      masks.scalar_type() != ScalarType::Char || quality.dim() != 2 ||
+      quality.size(0) != point_prompt_count ||
+      quality.size(1) != kCandidatesPerPoint ||
+      quality.scalar_type() != ScalarType::Char) {
+    printk("ERROR unexpected multimask output tensors\n");
+    return false;
+  }
+
+  const size_t candidate_count = masks.size(0) * masks.size(1);
+  if (candidate_count > kMaxCandidates) {
+    printk("ERROR too many mask candidates: %zu\n", candidate_count);
+    return false;
+  }
+
+  const int8_t* mask_data = masks.const_data_ptr<int8_t>();
+  const int8_t* quality_data = quality.const_data_ptr<int8_t>();
+  const auto mask_strides = masks.strides();
+  const auto quality_strides = quality.strides();
+  const size_t height = masks.size(2);
+  const size_t width = masks.size(3);
+  const size_t pixel_count = height * width;
+  const size_t minimum_area = std::max<size_t>(1, pixel_count / 200);
+  const size_t maximum_area = pixel_count * 85 / 100;
+
+  std::array<Candidate, kMaxCandidates> candidates{};
+  size_t accepted_count = 0;
+  for (size_t point = 0; point < static_cast<size_t>(masks.size(0)); ++point) {
+    size_t best_candidate = 0;
+    float best_quality = -1.0f;
+    for (size_t candidate = 0;
+         candidate < static_cast<size_t>(masks.size(1));
+         ++candidate) {
+      const size_t quality_index =
+          point * quality_strides[0] + candidate * quality_strides[1];
+      const float quality_score =
+          (static_cast<int32_t>(quality_data[quality_index]) -
+           model_quality_zero_point) *
+          model_quality_scale;
+      if (quality_score > best_quality) {
+        best_candidate = candidate;
+        best_quality = quality_score;
+      }
+    }
+    if (best_quality < minimum_mask_quality) {
+      continue;
+    }
+
+    const size_t offset =
+        point * mask_strides[0] + best_candidate * mask_strides[1];
+    const size_t foreground = count_foreground(
+        mask_data,
+        offset,
+        height,
+        width,
+        mask_strides[2],
+        mask_strides[3]);
+    if (foreground < minimum_area || foreground > maximum_area) {
+      continue;
+    }
+    candidates[accepted_count++] = {offset, foreground, best_quality};
+  }
+
+  std::sort(
+      candidates.begin(),
+      candidates.begin() + accepted_count,
+      [](const Candidate& first, const Candidate& second) {
+        return first.quality > second.quality;
+      });
+
+  selected.count = 0;
+  for (size_t index = 0;
+       index < accepted_count && selected.count < kMaxObjects;
+       ++index) {
+    bool duplicate = false;
+    for (size_t object = 0; object < selected.count; ++object) {
+      if (mask_iou(
+              mask_data,
+              candidates[index].offset,
+              selected.offsets[object],
+              height,
+              width,
+              mask_strides[2],
+              mask_strides[3]) > kDuplicateIou) {
+        duplicate = true;
+        break;
+      }
+    }
+    if (!duplicate) {
+      selected.offsets[selected.count] = candidates[index].offset;
+      selected.foreground[selected.count] = candidates[index].foreground;
+      ++selected.count;
+    }
+  }
+
+  printk(
+      "Mask proposals: %zu accepted, %zu distinct\n",
+      accepted_count,
+      selected.count);
+  return true;
+}
+
+void quantize_camera_frame(int8_t* data) {
+  const size_t plane_size = image_width * image_height;
+  auto* camera_pixels = reinterpret_cast<uint8_t*>(data);
+  for (size_t channel = 0; channel < image_channels; ++channel) {
+    for (size_t pixel = 0; pixel < plane_size; ++pixel) {
+      const size_t index = channel * plane_size + pixel;
+      const float normalized =
+          (static_cast<float>(camera_pixels[index]) -
+           model_pixel_mean[channel]) /
+          model_pixel_std[channel];
+      const int32_t quantized = static_cast<int32_t>(
+                                    std::round(normalized / model_input_scale)) +
+          model_input_zero_point;
+      data[index] = static_cast<int8_t>(std::clamp(quantized, -128, 127));
+    }
+  }
+}
+
+} // namespace
+
+int main() {
+  printk("\nLive MobileSAM / Ethos-U85-256 / Alif E8\n");
+  executorch::runtime::runtime_init();
+  if (initialize_display()) {
+    display_running();
+  }
+
+#if DT_NODE_EXISTS(DT_NODELABEL(ospi_flash))
+  const struct device* ospi_flash = DEVICE_DT_GET(DT_NODELABEL(ospi_flash));
+  if (!device_is_ready(ospi_flash)) {
+    printk("ERROR OSPI flash is not ready\n");
+    return 1;
+  }
+#else
+  printk("ERROR E8 OSPI flash device is unavailable\n");
+  return 1;
+#endif
+
+#if !defined(CONFIG_ALIF_OSPI_FLASH_XIP)
+  printk("ERROR OSPI XIP must be enabled\n");
+  return 1;
+#else
+  const auto* pte = reinterpret_cast<const uint8_t*>(ET_MODEL_PTE_ADDRESS);
+  printk(
+      "PTE address: 0x%08x, size: %u bytes\n",
+      static_cast<unsigned int>(ET_MODEL_PTE_ADDRESS),
+      static_cast<unsigned int>(ET_MODEL_PTE_SIZE));
+  printk("PTE flash verification: passed\n");
+
+  BufferDataLoader loader(pte, ET_MODEL_PTE_SIZE);
+  Result<Program> program_result = Program::load(&loader);
+  if (!program_result.ok()) {
+    printk(
+        "ERROR Program::load: 0x%08" PRIx32 "\n",
+        static_cast<uint32_t>(program_result.error()));
+    return 1;
+  }
+  Program program = std::move(program_result.get());
+  Result<MethodMeta> meta_result = program.method_meta("forward");
+  if (!meta_result.ok()) {
+    printk("ERROR method metadata\n");
+    return 1;
+  }
+  MethodMeta meta = std::move(meta_result.get());
+
+  ArmMemoryAllocator method_allocator(sizeof(method_pool), method_pool);
+  Span<uint8_t> planned_spans[kMaxPlannedBuffers];
+  const size_t planned_count = meta.num_memory_planned_buffers();
+  if (planned_count > kMaxPlannedBuffers) {
+    printk("ERROR too many planned buffers: %zu\n", planned_count);
+    return 1;
+  }
+  for (size_t i = 0; i < planned_count; ++i) {
+    const auto size_result = meta.memory_planned_buffer_size(i);
+    if (!size_result.ok()) {
+      return 1;
+    }
+    const size_t size = size_result.get();
+    auto* buffer = static_cast<uint8_t*>(method_allocator.allocate(size, 16));
+    if (buffer == nullptr) {
+      printk("ERROR planned buffer %zu (%zu bytes)\n", i, size);
+      return 1;
+    }
+    planned_spans[i] = Span<uint8_t>(buffer, size);
+    printk("Planned buffer %zu: %zu bytes\n", i, size);
+  }
+
+  HierarchicalAllocator planned_memory{
+      Span<Span<uint8_t>>(planned_spans, planned_count)};
+  ArmMemoryAllocator temp_allocator(sizeof(temp_pool), temp_pool);
+  MemoryManager memory_manager(
+      &method_allocator, &planned_memory, &temp_allocator);
+  Result<Method> method_result =
+      program.load_method("forward", &memory_manager);
+  if (!method_result.ok()) {
+    printk(
+        "ERROR load_method: 0x%08" PRIx32 "\n",
+        static_cast<uint32_t>(method_result.error()));
+    return 1;
+  }
+  Method method = std::move(method_result.get());
+
+  EValue input;
+  Error status = method.get_inputs(&input, 1);
+  if (status != Error::Ok || !input.isTensor()) {
+    printk("ERROR get input: 0x%08" PRIx32 "\n", (uint32_t)status);
+    return 1;
+  }
+  Tensor input_tensor = input.toTensor();
+  const size_t camera_frame_size = image_channels * image_width * image_height;
+  if (input_tensor.scalar_type() != ScalarType::Char ||
+      input_tensor.nbytes() != camera_frame_size) {
+    printk(
+        "ERROR expected %zu-byte int8 input, got %zu bytes type %d\n",
+        camera_frame_size,
+        input_tensor.nbytes(),
+        static_cast<int>(input_tensor.scalar_type()));
+    return 1;
+  }
+  auto* input_data = input_tensor.mutable_data_ptr<int8_t>();
+  if (!initialize_camera(
+          reinterpret_cast<uint8_t*>(input_data),
+          input_tensor.nbytes(),
+          image_width,
+          image_height)) {
+    while (true) {
+      k_sleep(K_SECONDS(1));
+    }
+  }
+
+  size_t frame_number = 0;
+  while (true) {
+    if (!capture_camera_frame()) {
+      return 1;
+    }
+    ++frame_number;
+    quantize_camera_frame(input_data);
+
+    const uint64_t start_cycles = k_cycle_get_64();
+    status = method.execute();
+    const uint64_t elapsed_cycles = k_cycle_get_64() - start_cycles;
+    if (status != Error::Ok) {
+      printk("ERROR execute: 0x%08" PRIx32 "\n", (uint32_t)status);
+      return 1;
+    }
+    const uint64_t inference_ms = k_cyc_to_ms_floor64(elapsed_cycles);
+
+    EValue outputs[2];
+    status = method.get_outputs(outputs, 2);
+    if (status != Error::Ok || !outputs[0].isTensor() ||
+        !outputs[1].isTensor()) {
+      printk("ERROR get multimask outputs\n");
+      return 1;
+    }
+    Tensor masks = outputs[0].toTensor();
+    Tensor quality = outputs[1].toTensor();
+    SelectedMasks selected{};
+    if (!select_masks(masks, quality, selected)) {
+      return 1;
+    }
+
+    const auto mask_strides = masks.strides();
+    display_result(
+        input_data,
+        masks.const_data_ptr<int8_t>(),
+        selected.offsets,
+        selected.count,
+        masks.size(2),
+        masks.size(3),
+        mask_strides[2],
+        mask_strides[3],
+        inference_ms,
+        selected.foreground);
+    record_live_status(frame_number, inference_ms, selected.count);
+    printk(
+        "Frame %zu: %" PRIu64 " ms, %zu objects\n",
+        frame_number,
+        inference_ms,
+        selected.count);
+
+    if (!release_camera_frame()) {
+      return 1;
+    }
+  }
+#endif
+}
