index 0000000000..7d79570c90
--- /dev/null
+++ b/zephyr/samples/mobilesam-ethosu/scripts/png_to_logo_header.py
@@ -0,0 +1,93 @@
+# Copyright 2026 Arm Limited and/or its affiliates.
+#
+# SPDX-License-Identifier: Apache-2.0
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+
+def resize_contained(image: Image.Image, width: int, height: int) -> Image.Image:
+    image = image.copy()
+    image.thumbnail((width, height), Image.Resampling.LANCZOS)
+    canvas = Image.new("RGBA", (width, height), (0, 0, 0, 0))
+    canvas.alpha_composite(
+        image, ((width - image.width) // 2, (height - image.height) // 2)
+    )
+    return canvas
+
+
+def prepare_executorch_logo(path: Path) -> Image.Image:
+    return resize_contained(Image.open(path).convert("RGBA"), 40, 40)
+
+
+def prepare_pytorch_logo(path: Path) -> Image.Image:
+    source = np.asarray(Image.open(path).convert("RGB"), dtype=np.uint8)
+    alpha = np.max(255 - source, axis=2).astype(np.uint8)
+    foreground = alpha > 0
+    orange = foreground & (source[:, :, 0] > source[:, :, 1] * 1.5)
+
+    rgba = np.zeros((*source.shape[:2], 4), dtype=np.uint8)
+    rgba[foreground, :3] = 255
+    rgba[orange, :3] = (238, 76, 44)
+    rgba[:, :, 3] = alpha
+    image = Image.fromarray(rgba, mode="RGBA")
+    bounding_box = image.getchannel("A").getbbox()
+    if bounding_box is None:
+        raise ValueError(f"PyTorch logo has no visible pixels: {path}")
+    return resize_contained(image.crop(bounding_box), 120, 30)
+
+
+def rgb565(red: int, green: int, blue: int) -> int:
+    return ((red & 0xF8) << 8) | ((green & 0xFC) << 3) | (blue >> 3)
+
+
+def emit_logo(name: str, image: Image.Image) -> str:
+    data = np.asarray(image, dtype=np.uint8)
+    pixels = [rgb565(*pixel[:3]) for pixel in data.reshape(-1, 4)]
+    alpha = data[:, :, 3].reshape(-1)
+
+    def rows(values: list[int] | np.ndarray, per_row: int, formatter: object) -> str:
+        return "\n".join(
+            "    "
+            + ", ".join(formatter(value) for value in values[index : index + per_row])
+            + ","
+            for index in range(0, len(values), per_row)
+        )
+
+    return f"""const size_t {name}_width = {image.width};
+const size_t {name}_height = {image.height};
+const uint16_t {name}_pixels[{len(pixels)}] = {{
+{rows(pixels, 12, lambda value: f'0x{value:04x}')}
+}};
+const uint8_t {name}_alpha[{len(alpha)}] = {{
+{rows(alpha, 20, lambda value: str(int(value)))}
+}};
+"""
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--executorch-logo", type=Path, required=True)
+    parser.add_argument("--pytorch-logo", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    header = """#include <stddef.h>
+#include <stdint.h>
+
+"""
+    header += emit_logo(
+        "executorch_logo", prepare_executorch_logo(args.executorch_logo)
+    )
+    header += emit_logo("pytorch_logo", prepare_pytorch_logo(args.pytorch_logo))
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(header)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/zephyr/samples/mobilesam-ethosu/src/camera.cpp b/zephyr/samples/mobilesam-ethosu/src/camera.cpp
new file mode 100644
index 0000000000..cc9111165d
--- /dev/null
+++ b/zephyr/samples/mobilesam-ethosu/src/camera.cpp
@@ -0,0 +1,249 @@
+/* Copyright 2026 Arm Limited and/or its affiliates.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "camera.h"
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/drivers/i2c.h>
+#include <zephyr/drivers/video.h>
+#include <zephyr/drivers/video/video_alif.h>
+#include <zephyr/init.h>
+#include <zephyr/kernel.h>
+#include <zephyr/sys/printk.h>
+#include <zephyr/sys/sys_io.h>
+
+#include <cerrno>
+#include <cstdint>
+
+#include "soc_common.h"
+
+extern "C" int log_level() {
+  return 0;
+}
+
+extern "C" volatile uint32_t camera_diagnostics[24];
+volatile uint32_t camera_diagnostics[24];
+
+namespace {
+
+const struct device* camera_device;
+struct video_buffer camera_buffer;
+bool frame_dequeued;
+const struct gpio_dt_spec mipi_camera_select =
+    GPIO_DT_SPEC_GET(DT_NODELABEL(camera_select), select_gpios);
+
+int enable_camera_pixel_clock() {
+  sys_write32(0x140001, CLKCTRL_PER_MST_CAMERA_PIXCLK_CTRL);
+  return 0;
+}
+
+SYS_INIT(enable_camera_pixel_clock, PRE_KERNEL_1, 46);
+
+} // namespace
+
+bool initialize_camera(
+    uint8_t* frame_buffer,
+    size_t frame_buffer_size,
+    size_t width,
+    size_t height) {
+  camera_diagnostics[0] = 0x43414d33;
+  camera_device = DEVICE_DT_GET_ONE(vsi_isp_pico);
+  camera_diagnostics[1] = device_is_ready(camera_device);
+  if (!device_is_ready(camera_device)) {
+    printk("ERROR camera ISP is not ready\n");
+    return false;
+  }
+
+  const struct device* camera_sensor = DEVICE_DT_GET_ONE(aptina_mt9m114);
+  const struct gpio_dt_spec sensor_power =
+      GPIO_DT_SPEC_GET(DT_NODELABEL(csi_cam_power), enable_gpios);
+  const struct gpio_dt_spec module_reset{
+      DEVICE_DT_GET(DT_NODELABEL(gpio9)), 1, GPIO_ACTIVE_LOW};
+  const struct gpio_dt_spec sensor_sleep{
+      DEVICE_DT_GET(DT_NODELABEL(gpio6)), 3, GPIO_ACTIVE_LOW};
+  int sensor_init_status =
+      gpio_pin_configure_dt(&mipi_camera_select, GPIO_OUTPUT_INACTIVE);
+  if (sensor_init_status == 0) {
+    sensor_init_status = gpio_pin_set_dt(&mipi_camera_select, 1);
+  }
+  if (sensor_init_status == 0) {
+    sensor_init_status =
+        gpio_pin_configure_dt(&module_reset, GPIO_OUTPUT_ACTIVE);
+  }
+  if (sensor_init_status == 0) {
+    sensor_init_status =
+        gpio_pin_configure_dt(&sensor_power, GPIO_OUTPUT_INACTIVE);
+  }
+  if (sensor_init_status == 0) {
+    sensor_init_status =
+        gpio_pin_configure_dt(&sensor_sleep, GPIO_OUTPUT_ACTIVE);
+  }
+  if (sensor_init_status == 0) {
+    k_usleep(100);
+    sensor_init_status = gpio_pin_set_dt(&sensor_power, 1);
+  }
+  if (sensor_init_status == 0) {
+    sensor_init_status = gpio_pin_set_dt(&module_reset, 0);
+    k_usleep(400);
+  }
+  if (sensor_init_status == 0) {
+    sensor_init_status = gpio_pin_set_dt(&sensor_sleep, 0);
+    k_usleep(39);
+  }
+  if (sensor_init_status == 0 && !device_is_ready(camera_sensor)) {
+    sensor_init_status = device_init(camera_sensor);
+  }
+  camera_diagnostics[2] = static_cast<uint32_t>(sensor_init_status);
+  camera_diagnostics[9] = static_cast<uint32_t>(sensor_init_status);
+  camera_diagnostics[10] = device_is_ready(camera_sensor);
+  if (!device_is_ready(camera_sensor)) {
+    printk(
+        "ERROR MT9M114 camera sensor initialization failed: %d\n",
+        sensor_init_status);
+    return false;
+  }
+
+  const struct i2c_dt_spec sensor_i2c =
+      I2C_DT_SPEC_GET(DT_NODELABEL(mt9m114_selfie));
+  uint8_t register_address[2] = {0x00, 0x00};
+  uint8_t register_value[2]{};
+  const int probe_status = i2c_write_read_dt(
+      &sensor_i2c,
+      register_address,
+      sizeof(register_address),
+      register_value,
+      sizeof(register_value));
+  camera_diagnostics[3] = static_cast<uint32_t>(probe_status);
+  camera_diagnostics[4] =
+      static_cast<uint16_t>(register_value[0] << 8) | register_value[1];
+
+  struct video_caps caps{};
+  const int caps_status =
+      video_get_caps(camera_device, VIDEO_EP_IN, &caps);
+  camera_diagnostics[11] = static_cast<uint32_t>(caps_status);
+  if (caps_status != 0) {
+    printk("ERROR camera capabilities unavailable: %d\n", caps_status);
+    return false;
+  }
+
+  struct video_format format{};
+  for (size_t i = 0; caps.format_caps[i].pixelformat != 0; ++i) {
+    const auto& candidate = caps.format_caps[i];
+    if (candidate.pixelformat == VIDEO_PIX_FMT_Y10P) {
+      format.pixelformat = candidate.pixelformat;
+      format.width = candidate.width_min;
+      format.height = candidate.height_min;
+    }
+  }
+  camera_diagnostics[12] = format.pixelformat;
+  camera_diagnostics[13] = (format.width << 16) | format.height;
+  if (format.pixelformat == 0) {
+    printk("ERROR camera RAW10 format unavailable\n");
+    return false;
+  }
+
+  format.pitch = format.width * 2;
+  const int input_status =
+      video_set_format(camera_device, VIDEO_EP_IN, &format);
+  camera_diagnostics[14] = static_cast<uint32_t>(input_status);
+  if (input_status != 0) {
+    printk(
+        "ERROR camera input format failed: %d (RAW10 %ux%u pitch %u)\n",
+        input_status,
+        format.width,
+        format.height,
+        format.pitch);
+    return false;
+  }
+
+  format.pixelformat = VIDEO_PIX_FMT_RGB888_PLANAR_PRIVATE;
+  format.width = width;
+  format.height = height;
+  format.pitch = width * 3;
+  const size_t required_size = format.pitch * format.height;
+  if (frame_buffer_size < required_size) {
+    printk(
+        "ERROR camera needs %zu bytes, model input has %zu\n",
+        required_size,
+        frame_buffer_size);
+    return false;
+  }
+  const int output_status =
+      video_set_format(camera_device, VIDEO_EP_OUT, &format);
+  camera_diagnostics[15] = static_cast<uint32_t>(output_status);
+  if (output_status != 0) {
+    printk("ERROR camera output format failed: %d\n", output_status);
+    return false;
+  }
+
+  camera_buffer = {};
+  camera_buffer.buffer = frame_buffer;
+  camera_buffer.size = required_size;
+  const int enqueue_status =
+      video_enqueue(camera_device, VIDEO_EP_OUT, &camera_buffer);
+  camera_diagnostics[16] = static_cast<uint32_t>(enqueue_status);
+  if (enqueue_status != 0) {
+    printk("ERROR camera buffer enqueue failed: %d\n", enqueue_status);
+    return false;
+  }
+  // The MT9M114 needs this stabilization interval before its first stream.
+  k_msleep(7000);
+  const int stream_status = video_stream_start(camera_device);
+  camera_diagnostics[17] = static_cast<uint32_t>(stream_status);
+  if (stream_status != 0) {
+    printk("ERROR camera stream start failed: %d\n", stream_status);
+    return false;
+  }
+
+  printk(
+      "Camera ready: MT9M114 to planar RGB %zux%zu\n", width, height);
+  return true;
+}
+
+bool capture_camera_frame() {
+  struct video_buffer* completed_buffer = nullptr;
+  const int status = video_dequeue(
+      camera_device, VIDEO_EP_OUT, &completed_buffer, K_FOREVER);
+  camera_diagnostics[18] = static_cast<uint32_t>(status);
+  if (status != 0 || completed_buffer != &camera_buffer) {
+    printk("ERROR camera frame dequeue failed: %d\n", status);
+    return false;
+  }
+  frame_dequeued = true;
+  gpio_pin_set_dt(&mipi_camera_select, 0);
+  return true;
+}
+
+bool release_camera_frame() {
+  if (!frame_dequeued) {
+    return false;
+  }
+  gpio_pin_set_dt(&mipi_camera_select, 1);
+  k_usleep(100);
+  const int enqueue_status =
+      video_enqueue(camera_device, VIDEO_EP_OUT, &camera_buffer);
+  camera_diagnostics[22] = static_cast<uint32_t>(enqueue_status);
+  if (enqueue_status != 0) {
+    printk("ERROR camera buffer requeue failed: %d\n", enqueue_status);
+    return false;
+  }
+  const int stream_status = video_stream_start(camera_device);
+  if (stream_status != 0 && stream_status != -EBUSY) {
+    printk("ERROR camera stream restart failed: %d\n", stream_status);
+    return false;
+  }
+  frame_dequeued = false;
+  return true;
+}
+
+void record_live_status(
+    uint32_t frame_number,
+    uint32_t inference_ms,
+    uint32_t object_count) {
+  camera_diagnostics[19] = frame_number;
+  camera_diagnostics[20] = inference_ms;
+  camera_diagnostics[21] = object_count;
+}
