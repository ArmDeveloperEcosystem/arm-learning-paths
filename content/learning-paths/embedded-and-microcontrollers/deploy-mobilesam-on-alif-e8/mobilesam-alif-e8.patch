+from pathlib import Path
+
+import pytest
+
+from examples.arm.mobilesam_prompt_segmentation_example_ethos_u.model_export.export_mobilesam import (
+    INPUT_SIZE,
+    parse_args,
+    resolve_point_prompts,
+)
+
+
+def test_minimal_export_arguments() -> None:
+    args = parse_args(
+        [
+            "--output-path",
+            "model.pte",
+            "--image",
+            "image.jpg",
+            "--point",
+            "219",
+            "193",
+        ]
+    )
+
+    assert args.output_path == Path("model.pte")
+    assert args.image == Path("image.jpg")
+    assert args.point == [[219.0, 193.0]]
+    assert not args.local_files_only
+    assert not args.quantized_io
+
+
+def test_point_prompts_must_be_inside_fixed_input() -> None:
+    assert resolve_point_prompts([[0, 0], [INPUT_SIZE - 1, INPUT_SIZE - 1]]) == [
+        (0.0, 0.0),
+        (447.0, 447.0),
+    ]
+
+    with pytest.raises(ValueError, match="must be inside"):
+        resolve_point_prompts([[INPUT_SIZE, 0]])
