+function(validate_arm_baremetal_toolchain)
+  set(setup_hint
+      "Run examples/arm/setup.sh, source examples/arm/arm-scratch/setup_path.sh, and configure a fresh build directory."
+  )
+  foreach(compiler IN ITEMS "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}")
+    execute_process(
+      COMMAND "${compiler}" -dumpmachine
+      OUTPUT_VARIABLE compiler_target
+      OUTPUT_STRIP_TRAILING_WHITESPACE
+      RESULT_VARIABLE compiler_target_result
+    )
+    if(compiler_target_result OR NOT compiler_target STREQUAL "arm-none-eabi")
+      message(
+        FATAL_ERROR
+          "MobileSAM requires the Arm GNU bare-metal toolchain, but ${compiler} targets '${compiler_target}'. ${setup_hint}"
+      )
+    endif()
+  endforeach()
+
+  include(CheckCSourceCompiles)
+  check_c_source_compiles(
+    [=[
+      #include <inttypes.h>
+      const char *unsigned_format = "%" PRIu64;
+      const char *hex_format = "%" PRIx64;
+      int main(void) {
+        return unsigned_format[0] == hex_format[0];
+      }
+    ]=]
+    ET_MOBILESAM_HAS_INTTYPES_FORMAT_MACROS
+  )
+  if(NOT ET_MOBILESAM_HAS_INTTYPES_FORMAT_MACROS)
+    message(
+      FATAL_ERROR
+        "The selected Arm C library does not provide PRIu64 and PRIx64 from inttypes.h. ${setup_hint}"
+    )
+  endif()
+
+  execute_process(
+    COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libstdc++.a
+    OUTPUT_VARIABLE cxx_standard_library
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    RESULT_VARIABLE cxx_standard_library_result
+  )
+  if(cxx_standard_library_result OR NOT EXISTS "${cxx_standard_library}")
+    message(
+      FATAL_ERROR
+        "The selected Arm C++ compiler cannot locate libstdc++.a. ${setup_hint}"
+    )
+  endif()
+endfunction()
+
+validate_arm_baremetal_toolchain()
+
