+    --output_path=${CMAKE_CURRENT_BINARY_DIR}/temp.yaml
+  RESULT_VARIABLE GEN_OPLIST_RESULT
+  OUTPUT_VARIABLE GEN_OPLIST_OUTPUT
+  ERROR_VARIABLE GEN_OPLIST_ERROR
+)
+if(NOT GEN_OPLIST_RESULT EQUAL 0)
+  message(
+    FATAL_ERROR
+      "gen_oplist.py failed with exit code ${GEN_OPLIST_RESULT}: ${GEN_OPLIST_ERROR}"
+  )
+endif()
+file(READ "${CMAKE_CURRENT_BINARY_DIR}/temp.yaml" GEN_OPLIST_CONTENT)
+if(GEN_OPLIST_CONTENT MATCHES "aten::" OR GEN_OPLIST_CONTENT MATCHES
+                                          "dim_order_ops::"
+)
+  message(
+    FATAL_ERROR
+      "The Alif sample requires a fully delegated --quantized-io PTE with no CPU operators."
+  )
+endif()
+
+execute_process(
+  COMMAND
+    ${Python3_EXECUTABLE}
+    "${CMAKE_CURRENT_LIST_DIR}/../../../backends/arm/scripts/get_ethosu_scratch_from_pte.py"
+    ${ET_PTE_FILE_PATH}
+  RESULT_VARIABLE SCRATCH_RESULT
+  OUTPUT_VARIABLE SCRATCH_OUTPUT
+  ERROR_VARIABLE SCRATCH_ERROR
+)
+if(NOT SCRATCH_RESULT EQUAL 0)
+  message(FATAL_ERROR "Could not inspect PTE scratch size: ${SCRATCH_ERROR}")
+endif()
+string(REGEX MATCH "max_scratch_size=([0-9]+)" _ "${SCRATCH_OUTPUT}")
+if(NOT CMAKE_MATCH_1)
+  message(FATAL_ERROR "PTE did not report an Ethos-U scratch size.")
+endif()
+set(ET_REQUIRED_SCRATCH_SIZE ${CMAKE_MATCH_1})
+
+find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
+project(executorch_mobilesam_ethosu)
+
+if(${CONFIG_EXECUTORCH_TEMP_ALLOCATOR_POOL_SIZE} LESS
+   ${ET_REQUIRED_SCRATCH_SIZE}
+)
+  message(
+    FATAL_ERROR
+      "CONFIG_EXECUTORCH_TEMP_ALLOCATOR_POOL_SIZE=${CONFIG_EXECUTORCH_TEMP_ALLOCATOR_POOL_SIZE} is smaller than the PTE requirement ${ET_REQUIRED_SCRATCH_SIZE}."
+  )
+endif()
+
+if(NOT DEFINED EXECUTORCH_DIR)
+  if(DEFINED ZEPHYR_EXECUTORCH_MODULE_DIR)
+    set(EXECUTORCH_DIR ${ZEPHYR_EXECUTORCH_MODULE_DIR})
+  else()
+    message(
+      FATAL_ERROR
+        "ExecuTorch module not found. Include it in ZEPHYR_EXTRA_MODULES."
+    )
+  endif()
+endif()
+
+include(${EXECUTORCH_DIR}/tools/cmake/Utils.cmake)
+
+set(MODEL_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated/model_metadata.h")
+set(LOGO_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated/logos.h")
+add_custom_command(
+  OUTPUT "${MODEL_HEADER}"
+  COMMAND
+    ${Python3_EXECUTABLE}
+    ${EXECUTORCH_DIR}/examples/arm/mobilesam_prompt_segmentation_example_ethos_u/runtime/image_to_array.py
+    --metadata ${MODEL_METADATA_PATH} --metadata-only --output ${MODEL_HEADER}
+  DEPENDS
+    ${MODEL_METADATA_PATH}
+    ${EXECUTORCH_DIR}/examples/arm/mobilesam_prompt_segmentation_example_ethos_u/runtime/image_to_array.py
+  COMMENT "Generating MobileSAM model metadata"
+  VERBATIM
+)
+
+add_custom_command(
+  OUTPUT "${LOGO_HEADER}"
+  COMMAND
+    ${Python3_EXECUTABLE}
+    ${CMAKE_CURRENT_LIST_DIR}/scripts/png_to_logo_header.py --executorch-logo
+    ${EXECUTORCH_DIR}/docs/source/_static/img/executorch-chip-logo-circle-32.png
+    --pytorch-logo
+    ${EXECUTORCH_DIR}/docs/source/_static/img/generic-pytorch-logo.png --output
+    ${LOGO_HEADER}
+  DEPENDS
+    ${CMAKE_CURRENT_LIST_DIR}/scripts/png_to_logo_header.py
+    ${EXECUTORCH_DIR}/docs/source/_static/img/executorch-chip-logo-circle-32.png
+    ${EXECUTORCH_DIR}/docs/source/_static/img/generic-pytorch-logo.png
+  COMMENT "Generating ExecuTorch and PyTorch logos"
+  VERBATIM
+)
+
+target_sources(
+  app
+  PRIVATE
+    src/camera.cpp src/display.cpp src/main.cpp ${MODEL_HEADER} ${LOGO_HEADER}
+    ${EXECUTORCH_DIR}/examples/arm/common/arm_memory_allocator.cpp
+)
+target_include_directories(
+  app PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated"
+              ${EXECUTORCH_DIR}/examples/arm/common
+)
+
+file(SIZE "${ET_PTE_FILE_PATH}" ET_MODEL_PTE_SIZE)
+target_compile_definitions(
+  app
+  PRIVATE
+    ET_MODEL_PTE_ADDRESS=${ET_MODEL_PTE_ADDRESS}
+    ET_MODEL_PTE_SIZE=${ET_MODEL_PTE_SIZE}
+    ET_SEGMENTATION_MASK_THRESHOLD=${MASK_THRESHOLD}
+    ET_ARM_METHOD_ALLOCATOR_POOL_SIZE=${CONFIG_EXECUTORCH_METHOD_ALLOCATOR_POOL_SIZE}
+    ET_ARM_BAREMETAL_SCRATCH_TEMP_ALLOCATOR_POOL_SIZE=${CONFIG_EXECUTORCH_TEMP_ALLOCATOR_POOL_SIZE}
+    ET_ARM_BAREMETAL_FAST_SCRATCH_TEMP_ALLOCATOR_POOL_SIZE=${CONFIG_EXECUTORCH_FAST_TEMP_ALLOCATOR_POOL_SIZE}
+)
+
+target_link_libraries(app PRIVATE libexecutorch)
+if(TARGET executorch_delegate_ethos_u)
+  executorch_target_link_options_shared_lib(executorch_delegate_ethos_u)
+  target_link_libraries(app PRIVATE executorch_delegate_ethos_u)
+else()
+  message(FATAL_ERROR "ExecuTorch Ethos-U delegate target was not built.")
+endif()
+if(TARGET ethosu_core_driver)
+  target_link_libraries(app PRIVATE ethosu_core_driver)
+endif()
