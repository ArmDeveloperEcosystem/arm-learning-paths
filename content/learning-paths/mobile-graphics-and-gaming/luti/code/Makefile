COMMON_SOURCES := luti_sme2_programming.c luti_sme2_programming_test.c
HOST_OS := $(shell uname -s)
HOST_ARCH := $(shell uname -m)
WARNINGS := -Wall -Wextra -Werror
# Keep non-streaming code runnable on Arm CPUs without SVE or SME2 so the
# runtime check can skip safely. SME2 functions enter streaming mode explicitly.
SME_FLAGS := -march=armv8-a+sme2+nosve2+nosve

MACOS_LLVM ?= /opt/homebrew/opt/llvm
MACOS_CC ?= $(MACOS_LLVM)/bin/clang
MACOS_OBJDUMP ?= $(MACOS_LLVM)/bin/llvm-objdump
MACOS_SDKROOT ?= $(shell xcrun --show-sdk-path 2>/dev/null)
CFLAGS ?= -O2 $(WARNINGS)

# LLVM 21 matches NDK r29 and is also used for native Arm Linux validation.
LINUX_CC ?= clang-21
LINUX_OBJDUMP ?= llvm-objdump-21
# Keep LLVM 21 builds unoptimized for the chained LUTI4-to-LUTI2 example.
ANDROID_CFLAGS ?= -O0 $(WARNINGS)
ANDROID_API ?= 35
ANDROID_NDK_HOME ?= $(NDK_PATH)
ANDROID_HOST_TAG := $(if $(filter Darwin,$(HOST_OS)),darwin-x86_64,linux-x86_64)
ANDROID_TOOLCHAIN := $(ANDROID_NDK_HOME)/toolchains/llvm/prebuilt/$(ANDROID_HOST_TAG)

ifeq ($(HOST_OS)-$(HOST_ARCH),Linux-aarch64)
# The NDK Linux tools are x86-64 binaries. Use native LLVM with the NDK's
# Android headers, sysroot, and compiler runtime on an Arm Linux host.
ANDROID_CC := $(LINUX_CC)
ANDROID_OBJDUMP := $(LINUX_OBJDUMP)
ANDROID_FLAGS := --target=aarch64-linux-android$(ANDROID_API) \
	--sysroot="$(ANDROID_TOOLCHAIN)/sysroot" \
	-resource-dir "$(ANDROID_TOOLCHAIN)/lib/clang/21"
ANDROID_LDFLAGS := --ld-path="$(shell command -v ld.lld-21 2>/dev/null)" --rtlib=compiler-rt
else
ANDROID_CC := $(ANDROID_TOOLCHAIN)/bin/aarch64-linux-android$(ANDROID_API)-clang
ANDROID_OBJDUMP := $(ANDROID_TOOLCHAIN)/bin/llvm-objdump
endif

.PHONY: all macos linux android setup-android check-macos check-linux check-ndk check-android clean
.PHONY: disassemble-example-1 disassemble-example-1-android

all: $(if $(filter Darwin,$(HOST_OS)),macos,linux)
macos: sme2_luti
linux: sme2_luti_linux
android: sme2_luti_android

# Keep entry-point and platform checks out of the introductory example source.
# Standalone example targets generate this runner automatically.
define EXAMPLE_1_RUNNER
/* Generated by the Makefile. */
#include <stdio.h>
#if defined(__APPLE__)
#include <sys/types.h>
#include <sys/sysctl.h>
#elif defined(__linux__)
#include <sys/auxv.h>
#include <asm/hwcap.h>
#ifndef HWCAP2_SME2
#define HWCAP2_SME2 (1UL << 37)
#endif
#endif

int ex1_luti_test(void);

int main(void) {
    int supported = 0;
#if defined(__APPLE__)
    size_t size = sizeof(supported);
    if (sysctlbyname("hw.optional.arm.FEAT_SME2", &supported, &size, NULL, 0) != 0)
        supported = 0;
#elif defined(__linux__)
    supported = (getauxval(AT_HWCAP2) & HWCAP2_SME2) != 0;
#endif
    if (!supported) {
        puts("SKIP: No support for SME2 on this device.");
        return 0;
    }
    return ex1_luti_test();
}
endef
export EXAMPLE_1_RUNNER

example_1_runner.c: Makefile
	@printf '%s\n' "$$EXAMPLE_1_RUNNER" > $@

check-macos:
	@test "$(HOST_OS)-$(HOST_ARCH)" = Darwin-arm64 || { echo "error: use an arm64 macOS host" >&2; exit 1; }
	@major="$$("$(MACOS_CC)" -dumpversion | cut -d. -f1)"; \
		test "$${major:-0}" -ge 22 || { echo "error: install Homebrew LLVM 22 or later" >&2; exit 1; }

check-linux:
	@test "$(HOST_OS)-$(HOST_ARCH)" = Linux-aarch64 || { echo "error: native Linux validation requires AArch64 Linux" >&2; exit 1; }
	@"$(LINUX_CC)" --version >/dev/null || { echo "error: install Clang 21" >&2; exit 1; }

check-ndk:
	@case "$(HOST_OS)-$(HOST_ARCH)" in Darwin-arm64|Darwin-x86_64|Linux-aarch64|Linux-x86_64) ;; \
		*) echo "error: use macOS or AArch64/x86-64 Linux for Android builds" >&2; exit 1 ;; esac
	@test -n "$(ANDROID_NDK_HOME)" && test -d "$(ANDROID_TOOLCHAIN)/sysroot" || \
		{ echo "error: set ANDROID_NDK_HOME to the NDK r29 directory" >&2; exit 1; }

check-android: check-ndk
	@major="$$("$(ANDROID_CC)" -dumpversion | cut -d. -f1)"; \
		test "$${major:-0}" -ge 21 || { echo "error: Clang 21 or later is required; run make setup-android" >&2; exit 1; }
ifeq ($(HOST_OS)-$(HOST_ARCH),Linux-aarch64)
	@ld.lld-21 --version >/dev/null
endif

# Only this explicit setup target installs packages. Builds never install tools.
setup-android: check-ndk
ifeq ($(HOST_OS)-$(HOST_ARCH),Linux-aarch64)
	@set -eu; \
	if ! command -v "$(LINUX_CC)" >/dev/null || \
	   ! command -v ld.lld-21 >/dev/null || ! command -v "$(LINUX_OBJDUMP)" >/dev/null; then \
		sudo apt-get update; \
		sudo apt-get install -y ca-certificates wget lsb-release gnupg software-properties-common; \
		setup_dir="$$(mktemp -d)"; \
		trap 'rm -rf "$$setup_dir"' EXIT; \
		wget -q https://apt.llvm.org/llvm.sh -O "$$setup_dir/llvm.sh"; \
		sudo bash "$$setup_dir/llvm.sh" 21; \
		sudo apt-get install -y llvm-21; \
	fi
endif
	@$(MAKE) --no-print-directory check-android
	@echo "Android toolchain ready. Run 'make android' to build."

# Rename only the example's main when compiling its object. The runner and
# combined test driver retain their own main and runtime capability checks.
example_1_macos.o: example_1_luti_sme2.c Makefile | check-macos
	"$(MACOS_CC)" $(CFLAGS) -march=native+sme2+nosve2+nosve \
		-isysroot "$(MACOS_SDKROOT)" -Dmain=ex1_luti_test -c $< -o $@

example_1_linux.o: example_1_luti_sme2.c Makefile | check-linux
	"$(LINUX_CC)" -O2 $(WARNINGS) $(SME_FLAGS) -Dmain=ex1_luti_test -c $< -o $@

example_1_android.o: example_1_luti_sme2.c Makefile | check-android
	"$(ANDROID_CC)" $(ANDROID_CFLAGS) $(SME_FLAGS) $(ANDROID_FLAGS) \
		-Dmain=ex1_luti_test -c $< -o $@

ifeq ($(HOST_OS),Darwin)
example_1_luti_sme2: example_1_macos.o example_1_runner.c
	"$(MACOS_CC)" -isysroot "$(MACOS_SDKROOT)" $^ -o $@
else
example_1_luti_sme2: example_1_linux.o example_1_runner.c
	"$(LINUX_CC)" --rtlib=compiler-rt $^ -o $@
endif

example_1_luti_sme2_android: example_1_android.o example_1_runner.c
	"$(ANDROID_CC)" $(ANDROID_FLAGS) $(ANDROID_LDFLAGS) $^ -o $@

# Filter instruction mnemonics, excluding function names that contain "luti2".
disassemble-example-1: example_1_luti_sme2
	@"$(if $(filter Darwin,$(HOST_OS)),$(MACOS_OBJDUMP),$(LINUX_OBJDUMP))" -d $< | \
		grep -E '[[:space:]](luti2|smopa)[[:space:]]'

disassemble-example-1-android: example_1_luti_sme2_android
	@"$(ANDROID_OBJDUMP)" -d $< | \
		grep -E '[[:space:]](luti2|smopa)[[:space:]]'

sme2_luti: $(COMMON_SOURCES) example_1_macos.o
	"$(MACOS_CC)" $(CFLAGS) -march=native+sme2+nosve2+nosve \
		-isysroot "$(MACOS_SDKROOT)" $^ -o $@

sme2_luti_linux: $(COMMON_SOURCES) example_1_linux.o
	"$(LINUX_CC)" -O0 $(WARNINGS) $(SME_FLAGS) --rtlib=compiler-rt $^ -o $@

sme2_luti_android: $(COMMON_SOURCES) example_1_android.o
	"$(ANDROID_CC)" $(ANDROID_CFLAGS) $(SME_FLAGS) $(ANDROID_FLAGS) $(ANDROID_LDFLAGS) $^ -o $@

clean:
	$(RM) sme2_luti sme2_luti_linux sme2_luti_android \
		example_1_runner.c example_1_luti_sme2 example_1_luti_sme2_android \
		example_1_macos.o example_1_linux.o example_1_android.o
